<?xml version="1.0" encoding="utf-8" ?>
<log4net>
	<appender name="documentgeneration_rolling_file_appender" type="log4net.Appender.RollingFileAppender">
		<file value="C:\\000 Projects\\App\\050 KingSight - Data Portal\\kingsightapi\\log\\kingsight.txt" />
		<appendToFile value="true" />
		<rollingStyle value="Size" />
		<maxSizeRollBackups value="0" />
		<maximumFileSize value="10MB" />
		<staticLogFileName value="true" />
		<layout type="log4net.Layout.PatternLayout">
			<conversionPattern value="%date  %-5level %logger - %message%newline" />
		</layout>
	</appender>
	<root>
		<level value="DEBUG" />
		<appender-ref ref="documentgeneration_rolling_file_appender" />
	</root>
	<logger name="irmapiv2">
		<level value="ALL" />
	</logger>
</log4net>
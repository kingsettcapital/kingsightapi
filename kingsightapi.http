###

GET {{api_HostAddress}}/api/NonKsServicedLoans
Accept: application/json

###

POST {{api_HostAddress}}/api/NonKsServicedLoans
Content-Type: application/json

{
  "loans": [
    {
      "loanName": "External Servicer Loan A",
      "asAtDate": "2026-03-31",
      "servicerId": "SVC-100",
      "description": "Quarterly capture test",
      "investor": "Investor A",
      "interestRate": 15.75,
      "principalBalance": 1000000,
      "userUpdatedBy": "system"
    }
  ]
}

###

PUT {{api_HostAddress}}/api/NonKsServicedLoans
Content-Type: application/json

{
  "loans": [
    {
      "nonKsServicedLoanKey": 1,
      "loanId": "NONKS-1",
      "principalBalance": 1050000,
      "userUpdatedBy": "system"
    }
  ]
}

